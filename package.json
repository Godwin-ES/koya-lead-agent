{
  "name": "koya-lead-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev:sidecar": "docker compose -f docker-compose.dev.yml up -d",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "check:workspace": "test ! -f web/pnpm-lock.yaml || (echo 'web/pnpm-lock.yaml exists - web/ has its own disconnected node_modules store again. Run: rm -f web/pnpm-lock.yaml && rm -rf web/node_modules && pnpm install' && exit 1)",
    "check:symlinks": "node scripts/check-symlinks.mjs",
    "check": "pnpm check:workspace && pnpm check:symlinks && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.116.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.1",
    "jsdom": "^30.1.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
