{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["tests/**/*.ts", "packages/core/src/**/*.ts"],
  "exclude": ["node_modules", "web", "worker/dist"]
}
