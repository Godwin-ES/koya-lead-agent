# Copy to .env.local and fill in. .env.local is git-ignored (see .gitignore).
# Never commit real values. See docs/provider-findings.md for how each of
# these was confirmed.

# --- Claude (worker: the Agent SDK runner, Tasks 15/22) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Gemini (worker: the dev-default runner, Task 14) ---
# Confirmed live via the Generative Language API model list,
# docs/provider-findings.md Step 2.
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Apify (worker: company discovery, Task 10) ---
# Must be the TEAM account token, never a personal one — runs are billed
# to whichever account started them. See PRD "Apify Usage Limits".
APIFY_API_KEY=
# Still unset - actor selection is blocked on Task 1 Step 3 (choosing a
# pay-per-result actor and confirming its pricing in the Apify Console).
# dispatchRaw() throws a clear error if a real call is attempted without
# this set; every automated test runs in replay mode and never needs it.
APIFY_ACTOR_ID=
# The actor's own input field name for its result cap - also pending
# Task 1 Step 3. "maxItems" is Apify's most common convention and what
# the plan's own tests assume; change once the real actor is chosen.
APIFY_CAP_FIELD_NAME=maxItems
# Placeholder per-result cost pending real console pricing (same blocker).
APIFY_EST_COST_PER_RESULT_USD=0.01

# --- Crawl4AI (worker, local dev only: docker-compose.dev.yml) ---
# Generate with: openssl rand -hex 24
CRAWL4AI_API_TOKEN=
CRAWL4AI_BASE_URL=http://localhost:11235

# --- Firecrawl (worker: deployed-default scraper, Task 11) ---
FIRECRAWL_API_KEY=

# --- Supabase (web: anon key + RLS; worker: service_role, Task 4/5) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (transaction pooler). Used by
# scripts/apply-migrations.mjs and tests/integration/ only - never by the
# web or worker runtime, which use the Supabase client libraries above.
SUPABASE_DB_URL=

# --- Runtime defaults (SYSTEM-DESIGN-NEXTJS.md §4.3, §4.4) ---
# gemini | agent-sdk
RUNNER_DEFAULT=gemini
# crawl4ai | firecrawl
SCRAPER_DEFAULT=crawl4ai
REPLAY_MODE=true

# NEXT_PUBLIC_ copies for the intake form's client-side defaults (Task 9) -
# same values as RUNNER_DEFAULT/SCRAPER_DEFAULT above, just also exposed
# to the browser since they're only UI defaults, not secrets.
NEXT_PUBLIC_RUNNER_DEFAULT=gemini
NEXT_PUBLIC_SCRAPER_DEFAULT=crawl4ai

# --- Intake form spend estimate only (web) ---
# Placeholders pending real Apify pricing confirmation
# (app/docs/provider-findings.md, Task 1 Step 3). Never used for actual
# budget enforcement, only the live "estimated maximum spend" shown
# before a run is created.
NEXT_PUBLIC_APIFY_EST_PER_CANDIDATE_USD=0.01
NEXT_PUBLIC_FIRECRAWL_EST_PER_PAGE_USD=0.002

# --- Failure injection (Task 20, SYSTEM-DESIGN-NEXTJS.md §13) ---
# Worker-side gate - never on in production without this explicit
# opt-in. A run's own injected_failure column has no effect at all
# unless this is exactly "true" on the WORKER's environment (checked in
# packages/core/src/providers/failure-injection.ts, not by the web app).
ALLOW_FAILURE_INJECTION=false
# UI-only mirror so /test-console can show a warning when the worker
# hasn't enabled injection - purely informational, does not itself gate
# anything; the real enforcement is the worker-side var above.
NEXT_PUBLIC_ALLOW_FAILURE_INJECTION=false
