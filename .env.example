# Copy to .env.local and fill in. .env.local is git-ignored (see .gitignore).
# Never commit real values. See docs/provider-findings.md for how each of
# these was confirmed.

# --- Claude (worker: the Agent SDK runner, Tasks 15/22) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Gemini (worker: the dev-default runner, Task 14) ---
# Confirmed live via the Generative Language API model list,
# docs/provider-findings.md Step 2.
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Apify (worker: company discovery, Task 10) ---
# Must be the TEAM account token, never a personal one — runs are billed
# to whichever account started them. See PRD "Apify Usage Limits".
APIFY_API_KEY=
APIFY_ACTOR_ID=

# --- Crawl4AI (worker, local dev only: docker-compose.dev.yml) ---
# Generate with: openssl rand -hex 24
CRAWL4AI_API_TOKEN=
CRAWL4AI_BASE_URL=http://localhost:11235

# --- Firecrawl (worker: deployed-default scraper, Task 11) ---
FIRECRAWL_API_KEY=

# --- Supabase (web: anon key + RLS; worker: service_role, Task 4/5) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (transaction pooler). Used by
# scripts/apply-migrations.mjs and tests/integration/ only - never by the
# web or worker runtime, which use the Supabase client libraries above.
SUPABASE_DB_URL=

# --- Runtime defaults (SYSTEM-DESIGN-NEXTJS.md §4.3, §4.4) ---
# gemini | agent-sdk
RUNNER_DEFAULT=gemini
# crawl4ai | firecrawl
SCRAPER_DEFAULT=crawl4ai
REPLAY_MODE=true
